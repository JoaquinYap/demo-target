  "title": "Falsy-value erasure: `value or default` silently replaces any valid falsy config value (0, False, empty string) with the default.",
  "repo": "demo-target/antibody-demo",
  "root_cause": {
    "title": "Falsy-value erasure: `value or default` silently replaces any valid falsy config value (0, False, empty string) with the default.",
    "pattern": "A config/settings lookup uses `value or default` (boolean short-circuit) instead of an explicit `None`-check, so legitimate falsy values such as 0, False, or '' are treated as absent and overwritten by the default."
  },
  "original": {
    "file": "src/config_loader.py",
    "line": 8
  },
  "twins": [
    {
      "id": "c01",
      "file": "src/feature_flags.py",
      "line": 10,
      "status": "fixed",
      "reasoning": "Identical pattern: flags.get(name) returns False when a flag is explicitly disabled, but `or default` replaces it with True (the default), inverting the explicit configuration."
    },
    {
      "id": "c02",
      "file": "src/feature_flags.py",
      "line": 16,
      "status": "fixed",
      "reasoning": "rate_limit=0 (block all traffic) is a valid and meaningful value; `or default` would silently replace it with 100, defeating the intent."
    },
    {
      "id": "c03",
      "file": "src/env_helpers.py",
      "line": 10,
      "status": "fixed",
      "reasoning": "PORT=0 is a valid OS value (kernel assigns a random port); `or default` replaces it with 8080, breaking the caller's intent."
    },
    {
      "id": "c04",
      "file": "src/env_helpers.py",
      "line": 16,
      "status": "fixed",
      "reasoning": "WORKERS=0 means 'disabled'; `or default` silently returns 4 workers instead."
    },
    {
      "id": "c05",
      "file": "src/env_helpers.py",
      "line": 22,
      "status": "fixed",
      "reasoning": "An empty string prefix \"\" means 'serve at root'; `or default` replaces it with '/api', misrouting all requests."
    }
  ],
